# Hub (« homepage ») — variables d'environnement (à renseigner dans Coolify, jamais commitées)
# Connexion du Hub (login HTTP, cookie signé)
WEB_USERNAME=
WEB_PASSWORD=
SESSION_SECRET=

# Newsletter — le Hub appelle le service newsletter-summary /api/* sur le réseau Docker `coolify`.
# NEWSLETTER_API_TOKEN doit être identique à HUB_API_TOKEN défini côté newsletter-summary.
NEWSLETTER_URL=http://newsletter-summary:8000
NEWSLETTER_API_TOKEN=

# DeepInfra
DEEPINFRA_API_KEY=
DEEPINFRA_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731

# Job matinal
SUMMARY_HOUR=8
SUMMARY_MINUTE=0

# Sécurité webhook inbound
WEBHOOK_TOKEN=

# Hub (app « homepage ») — protège les endpoints /api/* (KB + prompt) qui, bien que
# destinés au réseau Docker, sont aussi atteignables publiquement via le sous-domaine
# mails.* → YOBI.token obligatoire. Identique à NEWSLETTER_API_TOKEN du Hub.
HUB_API_TOKEN=

# COMMS-GATEWAY — l'envoi passe par le gateway (plus de clé Resend dans ce projet)
GATEWAY_URL=http://comms-gateway:8000
GATEWAY_TOKEN=<token scoped fourni par le gateway lors de l'onboarding du client>

            },
            {
              "symbol": "s",
              "meaning": "path length through the air",
              "unit": "m"
            },
            {
              "symbol": "I_0",
              "meaning": "incident sunlight intensity"
            },
            {
              "symbol": "\\beta",
              "meaning": "extinction coefficient of the air",
              "unit": "1/m"
            }
          ]
        }

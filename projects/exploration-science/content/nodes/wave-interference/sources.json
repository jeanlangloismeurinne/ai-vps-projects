      ],
      "usedBy": [
        "levels.advanced.play.bands"
      ]
    },
    {
      "id": "phase-shift",
      "claim": "Un déphasage Δφ entre sources décale les maxima : d sin θ = (m + Δφ/2π) λ ; c'est le principe des réseaux d'antennes orientables.",
      "status": "verified",
      "sources": [
        "gpsworld-physics",
        "oregonstate-two-source"
      ],
      "usedBy": [
        "play.shift",
        "play.many"
      ],
      "note": "Même relation que Δφ = 2π d sin θ / λ du nœud starlink-phased-array (m = 0)."
    },
    {
      "id": "wavelength-12ghz",
      "claim": "Longueur d'onde à 12 GHz ≈ 25 mm.",
      "value": 0.025,
      "unit": "m",
      "status": "computed",
      "formula": "λ = c / f = 299 792 458 / 12 × 10⁹ ≈ 0,025 m",
      "sources": [],

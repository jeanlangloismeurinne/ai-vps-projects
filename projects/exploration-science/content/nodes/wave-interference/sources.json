    {
      "id": "maxima-1-5-lambda",
      "claim": "Pour d = 1,5 λ, maxima à 0° et ± 41,8°.",
      "status": "computed",
      "formula": "sin θ = m / 1,5 → m = ±1 : θ = 41,8° ; |m| ≥ 2 hors du visible",
      "sources": [],

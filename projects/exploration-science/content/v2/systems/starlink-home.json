  "externals": [
    {
      "id": "internet",
      "anchors": [
        "pop"
      ]
    }
  ],
  "connections": [
    {
      "id": "uplink",
      "from": "terminal#beam",
      "to": "satellite#antenna",
      "kind": "radio"
    },
    {
      "id": "feeder",
      "from": "satellite#antenna",
      "to": "ground-station#dish",
      "kind": "radio"
    },
    {
      "id": "backhaul",
      "from": "ground-station#fibre",
      "to": "internet#pop",
      "kind": "fibre"
    }
  ],
  "flows": [
    {
      "id": "data-down",
      "path": [
        "backhaul",
        "feeder",
        "uplink"
      ],
      "direction": "reverse"
    }
  ]
}

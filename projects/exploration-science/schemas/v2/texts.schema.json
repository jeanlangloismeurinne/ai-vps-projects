{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://exploration-science/schemas/v2/texts.schema.json",
  "title": "System texts for one language (V2 format v2-0.1)",
  "description": "Cards of the main objects and tour subtitles, written to be read aloud. Every figure points to a fact of sources.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "systemId", "lang", "entries", "cards"],
  "properties": {
    "formatVersion": { "const": "v2-0.1" },
    "systemId": { "$ref": "#/$defs/id" },
    "lang": { "type": "string", "pattern": "^[a-z]{2}$" },
    "entries": {
      "description": "Free keys: system title, tour subtitles.",
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9]+([._-][a-z0-9]+)*$" },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "cards": {
      "description": "One card per main object, keyed by object id.",
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "summary", "figures"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1, "description": "One sentence." },
          "figures": {
            "type": "array",
            "minItems": 2,
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["label", "value", "factId"],
              "properties": {
                "label": { "type": "string", "minLength": 1 },
                "value": { "type": "string", "minLength": 1, "description": "As displayed, unit included." },
                "spoken": { "type": "string", "minLength": 1, "description": "As read aloud, when it differs." },
                "factId": { "$ref": "#/$defs/id" }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
  }
}

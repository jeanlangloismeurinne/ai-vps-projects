{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://exploration-science/schemas/v2/assets.schema.json",
  "title": "Asset scripts (V2 format v2-0.1)",
  "description": "art/assets.json: which Blender script builds each representation of each object, and which systems `npm run assets` builds.",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "out", "bake", "build", "assets"],
  "properties": {
    "formatVersion": { "const": "v2-0.1" },
    "out": { "type": "string", "description": "Output directory, relative to the project." },
    "bake": {
      "type": "object",
      "additionalProperties": false,
      "required": ["samples", "distance"],
      "properties": {
        "samples": { "type": "integer", "minimum": 1 },
        "distance": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "build": {
      "description": "System files to build, relative to the project.",
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "\\.json$" }
    },
    "assets": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["envelope"],
        "properties": {
          "envelope": { "$ref": "#/$defs/script" },
          "detail": { "$ref": "#/$defs/script" }
        }
      }
    }
  },
  "$defs": {
    "script": {
      "type": "object",
      "additionalProperties": false,
      "required": ["script"],
      "properties": {
        "script": { "type": "string", "pattern": "^[a-z_]+(\\.[a-z0-9_]+)+$", "description": "Python module under art/, with a build(**params) -> Asset." },
        "params": { "type": "object" }
      }
    }
  }
}

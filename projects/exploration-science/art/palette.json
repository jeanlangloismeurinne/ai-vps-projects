    "light": { "color": "#d3d7e1", "roughness": 0.6, "metallic": 0.0 },
    "mid": { "color": "#a2a9b8", "roughness": 0.5, "metallic": 0.0 },
    "metal": { "color": "#8d95a5", "roughness": 0.35, "metallic": 0.8 },
    "graphite": { "color": "#3b404c", "roughness": 0.55, "metallic": 0.0 }
  },
  "accents": {
    "signal": { "color": "#3461f0", "roughness": 0.45, "metallic": 0.0 },

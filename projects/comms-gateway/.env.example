# ---------------------------------------------------------------------------
# comms-gateway — variables d'environnement (valeurs réelles en secrets Coolify
# ou .env local hors git). Aucun secret réel ne doit être committé.
# ---------------------------------------------------------------------------

# Base partagée (shared-postgres) — le gateway crée/un migrate sa base
DATABASE_URL=postgresql://admin:CHANGE_ME@shared-postgres:5432/db_comms_gateway

# Redis partagé (shared-redis) pour le rate limiting
REDIS_URL=redis://:CHANGE_ME@shared-redis:6379/0

# Secret maître : chiffre les credentials providers stockés en BDD (provider_accounts)
# 32 octets base64, généré une fois : openssl rand -base64 32
MASTER_KEY=

# Token admin : protège les endpoints admin (coupure à chaud, lecture clients)
ADMIN_TOKEN=CHANGE_ME

# ---------------------------------------------------------------------------
# Connecteur Email (Resend) — compte principal via env (spec : secrets au gateway)
# ---------------------------------------------------------------------------
RESEND_API_KEY=
# Adresses de départ par défaut ; surchargeable par projet via provider_accounts
RESEND_DEFAULT_FROM=

# ---------------------------------------------------------------------------
# Connecteur Slack — bot Slack PROPRE au gateway (distinct de celui d'assistant-ia)
# ---------------------------------------------------------------------------
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
# Base publique du gateway pour le webhook d'événements Slack (events API)
PUBLIC_BASE_URL=https://comms.jlmvpscode.duckdns.org

# ---------------------------------------------------------------------------
# Connecteurs SMS / WhatsApp / Signal — PAS ENCORE ACTIFS (matériel Phase 0)
# Positions vides tant que le téléphone/eSIM/Tailscale ne sont pas en place.
# ---------------------------------------------------------------------------
SMSGATE_BASE_URL=
WHATSAAP_SESSION_DIR=/data/whatsapp
SIGNAL_SESSION_DIR=/data/signal

# ---------------------------------------------------------------------------
# Connecteur email — webhook inbound Resend (sécurité)
# ---------------------------------------------------------------------------
# Secret de signature Svix fourni par Resend pour le webhook email.inbound
RESEND_WEBHOOK_SECRET=
# Token additionnel exigé en ?token= en complément de la signature
WEBHOOK_TOKEN=
